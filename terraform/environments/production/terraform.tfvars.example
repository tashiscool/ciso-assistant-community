# Copy this to terraform.tfvars and fill in real values.
# Secrets should use TF_VAR_ environment variables instead.
#
# export TF_VAR_db_master_password="your-secure-password"
# export TF_VAR_django_secret_key="your-32-char-secret"

acm_certificate_arn    = "arn:aws:acm:us-east-1:123456789012:certificate/abc-def-ghi"
django_superuser_email = "admin@example.com"
