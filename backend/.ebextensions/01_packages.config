# System packages required by CISO Assistant backend on Amazon Linux 2023.
# Package names follow RHEL/Fedora conventions (AL2023 uses dnf/yum).
#
# Keep in sync with:
#   - backend/Dockerfile            (Debian apt names)
#   - deploy/ec2-rhel8/deploy.sh    (RHEL dnf names)
#   - deploy/ubuntu-fips/deploy.sh  (Ubuntu apt names)
#   - scripts/mac-dev-setup.sh      (Homebrew names)

packages:
  yum:
    # --- WeasyPrint / PDF generation ---
    pango: []
    pango-devel: []
    cairo: []
    cairo-devel: []
    gdk-pixbuf2: []
    gdk-pixbuf2-devel: []
    fontconfig: []
    liberation-sans-fonts: []

    # --- lxml / XML processing ---
    libxml2-devel: []
    libxslt-devel: []

    # --- xmlsec / SAML SSO ---
    xmlsec1: []
    xmlsec1-devel: []
    xmlsec1-openssl-devel: []

    # --- Build tools ---
    pkgconfig: []
    libffi-devel: []
    python3-devel: []

    # --- YAML processing (PyYAML C extension) ---
    libyaml-devel: []

    # --- Compression ---
    zlib-devel: []

    # --- PostgreSQL client (psycopg2 build) ---
    postgresql15-devel: []

    # --- Django i18n ---
    gettext: []

    # --- Locales ---
    glibc-langpack-en: []
    glibc-langpack-ar: []
    glibc-langpack-fr: []
    glibc-langpack-pt: []
    glibc-langpack-es: []
    glibc-langpack-de: []
    glibc-langpack-nl: []
    glibc-langpack-it: []
    glibc-langpack-pl: []
    glibc-langpack-ro: []
    glibc-langpack-hi: []
    glibc-langpack-ur: []
    glibc-langpack-cs: []
    glibc-langpack-sv: []
    glibc-langpack-id: []
