{
  "name": "ciso-assistant-edge-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "demo:video": "node ./scripts/record_demo_videos.mjs",
    "demo:video:publish": "node ./scripts/record_demo_videos.mjs --voiceover --render",
    "demo:voiceover": "node ./scripts/record_demo_videos.mjs --voiceover --render --skip-recording",
    "test:demo-video": "node ./scripts/record_demo_videos.mjs --smoke",
    "verify:a11y-tokens": "node ./scripts/verify_accessibility_tokens.mjs",
    "typecheck": "tsc --noEmit",
    "verify:ia-shell": "node ./scripts/verify_ia_shell.mjs",
    "verify:responsive": "node ./scripts/verify_responsive_routes.mjs",
    "verify:observable-import-ui": "node ./scripts/verify_observable_import_ui.mjs",
    "test:observable-import-ui": "node ./scripts/verify_observable_import_ui.mjs",
    "verify:api-client": "node ./scripts/verify_api_client_contract.mjs",
    "verify:toolchain": "node --test ./scripts/web_toolchain_migration.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.452.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.0",
    "vite": "^8.3.4"
  }
}
