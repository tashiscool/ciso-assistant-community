# Regovise Cloudflare production deployment settings
# Copy to `cloudflare/.env.production.local` and fill in private values.

# Cloudflare account + deploy auth
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TOKEN_VERIFY_URL=
CLOUDFLARE_WORKER_ENV=production

# Worker + domain targets
REGOVISE_WORKER_SERVICE_NAME=ciso-assistant-edge-production
REGOVISE_PROD_BASE_URL=https://regovise.com
D1_DATABASE_NAME=ciso-assistant-d1

# Deploy flow toggles
RUN_PREDEPLOY_TESTS=1
APPLY_D1_MIGRATIONS=0
RUN_POST_DEPLOY_SMOKE=1
RUN_SECRET_SYNC=1
DRY_RUN=0

# Production smoke identity
PROD_SMOKE_TENANT_ID=tenant-demo
PROD_SMOKE_USER_ID=user-demo

# Latency budgets for production smoke
LATENCY_PROBE_ITERATIONS=5
LATENCY_P95_BUDGET_MS=1000
LATENCY_ENFORCE_BUDGET=0

# Mail configuration for notifications and one-time email-code sign-in
EMAIL_PROVIDER=none
EMAIL_FROM=no-reply@regovise.com
EMAIL_FROM_NAME=Regovise
EMAIL_TIMEOUT_SECONDS=10
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_BEARER_TOKEN=
EMAIL_MAILCHANNELS_URL=https://api.mailchannels.net/tx/v1/send
EMAIL_DKIM_DOMAIN=regovise.com
EMAIL_DKIM_SELECTOR=mcdkim
MAILCHANNELS_API_KEY=

# First-run bootstrap and guarded admin recovery
BOOTSTRAP_SETUP_SECRET=
